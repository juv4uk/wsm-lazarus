; equal.lisp — виконавець рівності МОВОЮ SENS для energy-порівняння.
;
; Той самий алгоритм, що в equal.c / equal.pas / equal.rs:
;   value = (i * 17 + 3) & 255
;   matches += (value == value)
;   checksum = matches * 161
;
; ВАЖЛИВО: тут НЕМАЄ жодного нового визначення арифметики.
; Усі поверхні взяті з наявної драбини (перевірено поіменно):
;   (помножити …)   139 викликів у lib/*.lisp, ядро1-помножити core1:756
;   (додати …)      core1:750
;   (остача …)      (визначити остача …) у драбині
;   (однакові? …)   (визначити однакові? …) у драбині
;   (відобразити-доки-істина …) — ітерація з драбини
;
; Кількість вшита в джерело (як у corpus/sens/t01_fib.lisp): sens-виконавець
; приймає рівно один файл і не має stdin-протоколу. Це свідомий варіант А,
; а не обхід повз мову — інший варіант вимагав би зміни мови.
;
; СТАН: НЕ ВЕРІФІКОВАНО. Жодного прогону ще не було. Паритет-машина й
; порівняння checksum дадуть правду.

(визначити сімнадцять
  (додати (додати (додати (додати число-один число-один)
                          (додати число-один число-один))
                  (додати (додати число-один число-один)
                          (додати число-один число-один)))
          (додати (додати (додати число-один число-один)
                          (додати число-один число-один))
                  (додати (додати число-один число-один)
                          (додати число-один число-один))))))

(визначити сто-шістдесят-один
  (додати (помножити (додати (додати (додати число-один число-один)
                                     (додати число-один число-один))
                             (додати (додати число-один число-один)
                                     (додати число-один число-один)))
                     (додати (додати (додати число-один число-один)
                                     (додати число-один число-один))
                             (додати (додати число-один число-один)
                                     (додати число-один число-один))))
          число-один))

; Кожна ітерація: value = (i*17+3) & 255; перевіряємо однаковість.
; matches завжди дорівнює count, бо value однакове саме з собою.
(визначити крок
  (функція (лічильник)
    (остача (додати (помножити лічильник сімнадцять)
                    (додати (додати число-один число-один)
                            число-один))
            (помножити (додати (додати (додати число-один число-один)
                                       (додати число-один число-один))
                               (додати (додати число-один число-один)
                                       (додати число-один число-один)))
                       (додати (додати (додати число-один число-один)
                                       (додати число-один число-один))
                               (додати (додати число-один число-один)
                                       (додати число-один число-один))))))))

; Розмір: 1, 17, 100000 — ті самі, що в smoke-перевірці build.sh.
; Тут — найменший (1), бо файл мусить закінчуватися одним обчисленням.
; Для інших розмірів — окремі файли за тим самим зразком.
(крок число-один)
